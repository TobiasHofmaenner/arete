{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    // Track versions marked with a "# renovate: datasource=... depName=..." comment
    // in workflow env blocks and in the Makefile.
    'customManagers:githubActionsVersions',
    'customManagers:makefileVersions',
  ],
  timezone: 'Europe/Zurich',
  // Report known vulnerabilities in dependencies even without GitHub alert access.
  osvVulnerabilityAlerts: true,
  postUpdateOptions: ['gomodTidy'],
  customManagers: [
    {
      customType: 'regex',
      description: 'golangci-lint and plugin versions in .custom-gcl.yml',
      managerFilePatterns: ['/^\\.custom-gcl\\.yml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*version: (?<currentValue>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      description: 'Kubernetes libraries move together',
      matchPackageNames: ['k8s.io/**', 'sigs.k8s.io/controller-runtime', 'sigs.k8s.io/controller-tools'],
      groupName: 'kubernetes libraries',
    },
    {
      description: 'Kubernetes library minors follow the cluster version: approve on the dashboard',
      matchPackageNames: ['k8s.io/**', 'sigs.k8s.io/controller-runtime', 'sigs.k8s.io/controller-tools'],
      matchUpdateTypes: ['minor', 'major'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'golangci-lint: Makefile and .custom-gcl.yml must change together',
      matchPackageNames: ['github.com/golangci/golangci-lint/v2'],
      groupName: 'golangci-lint',
    },
    {
      description: 'Other Go module patch and minor updates in one pull request',
      matchManagers: ['gomod'],
      matchUpdateTypes: ['patch', 'minor', 'digest'],
      matchPackageNames: ['!k8s.io/**', '!sigs.k8s.io/controller-runtime', '!sigs.k8s.io/controller-tools', '!go'],
      groupName: 'go modules',
    },
    {
      description: 'Go itself: keep the go directive in go.mod current',
      matchManagers: ['gomod'],
      matchDepTypes: ['golang'],
      rangeStrategy: 'bump',
    },
    {
      description: 'Go itself: go.mod and the builder image move together',
      matchPackageNames: ['go', 'golang'],
      groupName: 'go toolchain',
    },
  ],
}
